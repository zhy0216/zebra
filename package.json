{
  "name": "zebra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": ["packages/*", "examples/*", "bench"],
  "scripts": {
    "test": "bun test",
    "bench": "bun run bench/bench.ts",
    "bench:check": "bun run bench/bench-regression.ts",
    "build": "bun --filter='*' run build",
    "release": "bun scripts/release.ts",
    "typecheck": "bun --filter='*' run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify:packages": "bun scripts/verify-packages.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.4.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.0",
    "vitepress": "1.6.4",
    "zod": "^3.24.0"
  }
}
