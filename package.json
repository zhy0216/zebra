{
  "name": "zebra-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "examples/*", "bench"],
  "scripts": {
    "test": "bun test",
    "bench": "bun run bench/bench.ts",
    "bench:check": "bun run bench/bench-regression.ts",
    "build": "bun --filter='*' run build",
    "release": "bun scripts/release.ts",
    "typecheck": "bun --filter='*' run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify:packages": "bun scripts/verify-packages.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  }
}
