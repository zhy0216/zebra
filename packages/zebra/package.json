{
  "name": "@zebra-web/zebra",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun --packages external"
  },
  "dependencies": {
    "@zebra-web/core": "workspace:*",
    "@zebra-web/cors": "workspace:*",
    "@zebra-web/session": "workspace:*",
    "@zebra-web/rate-limit": "workspace:*"
  }
}
