{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "files": {
    "ignore": [
      "**/node_modules",
      "**/dist",
      "**/test-setup.ts",
      "packages/core/src/di/decorators.ts",
      "packages/core/test/middleware/helper.test.ts",
      "packages/core/test/di/decorators.test.ts",
      "packages/core/test/di/circular.test.ts",
      "packages/core/test/di/scope-request.test.ts",
      "packages/core/test/di/scope-transient.test.ts",
      "packages/core/test/di/scope-session.test.ts",
      "packages/core/test/app/inject-methods.test.ts",
      "packages/core/test/app/inject-boot-validation.test.ts",
      "packages/core/test/app/session.test.ts",
      "packages/core/test/app/route-deps.test.ts",
      "packages/core/test/app/ws.test.ts",
      "packages/core/test/app/boot-validation.test.ts",
      "packages/core/test/app/lifecycle.test.ts",
      "packages/testing/test/test-app.test.ts"
    ]
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off",
        "noParameterAssign": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off",
        "noAssignInExpressions": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off",
        "noForEach": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
